{
  "name": "saucedemo-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript e2e tests for Swag Labs (saucedemo.com)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:fresh": "npm ci && playwright install --with-deps chromium && playwright test",
    "test": "playwright test",
    "report": "playwright show-report",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack": "git archive --format=zip --prefix=saucedemo-playwright/ -o saucedemo-playwright.zip HEAD"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.12.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
